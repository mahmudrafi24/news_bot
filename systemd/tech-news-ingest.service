[Unit]
Description=Collect Google News market headlines with Codex and publish Market Ledger

[Service]
Type=oneshot
WorkingDirectory=%h/news_bot
EnvironmentFile=-%h/.config/tech-news/pages.env
EnvironmentFile=-%h/.config/tech-news/shared.env
Environment=CODEX_BIN=%h/.local/bin/codex
ExecStart=/usr/bin/python3 collector.py --publish
ExecStartPost=/usr/bin/python3 %h/newspaper_dashboard/dashboard.py deploy
